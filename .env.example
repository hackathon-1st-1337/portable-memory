# Copy to .env and fill in. Never commit .env.

# --- Neon Auth (required) ---------------------------------------------------
# Neon Console → your branch → Auth → Configuration. Includes the /neondb/auth path.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Neon Postgres (used by the memory store) ---------------------------------
# Pooled connection string, SSL required.
DATABASE_URL=

# --- Written by `neon deploy`; not read by the app yet ----------------------
NEON_AUTH_URL=
NEON_JWKS_URL=

# --- Neon Object Storage ---------------------------------------------------
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# --- Security: Token HMAC Pepper --------------------------------------------
TOKEN_PEPPER=

# --- Cloudflare Workers AI (LLM & Embeddings) -------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
